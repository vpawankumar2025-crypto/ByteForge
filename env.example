PORT=3000

# Any long random string — used to sign login sessions
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of emails that get admin dashboard access
# (view all students, revenue, disqualify/re-qualify). Use your own signup email.
ADMIN_EMAILS=you@example.com

# REQUIRED for production. Without this, student accounts/enrollments are
# stored in a local file that can be wiped on redeploy/restart (fine for
# local testing, NOT safe for real students). Get a free connection string
# from https://www.mongodb.com/cloud/atlas (free M0 tier, no cost).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Your live site URL — used to build the QR-code verification link printed
# on certificates. Set this to your actual Render URL once deployed.
SITE_URL=https://your-site.onrender.com

# Get these from https://dashboard.razorpay.com/app/keys (use TEST mode keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# --- Email (invoice + offer letter delivery) ---
# Pick ONE provider and fill in its values. All three work through the same SMTP settings.
#
# Gmail (free, fastest to set up):
#   1. Turn on 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords and create an app password
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=<the 16-character app password, no spaces>
#
# Resend (https://resend.com):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=<your Resend API key>
#
# Brevo (https://www.brevo.com):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your Brevo SMTP login>
#   SMTP_PASS=<your Brevo SMTP key>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ByteForge <hello@byteforge.dev>

# Shown on invoices and offer letters
COMPANY_NAME=ByteForge
COMPANY_ADDRESS=Chennai, Tamil Nadu, India
